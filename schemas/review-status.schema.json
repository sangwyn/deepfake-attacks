{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangwyn/deepfake-attacks/schemas/review-status.schema.json",
  "title": "AADD campaign review status",
  "type": "object",
  "required": ["schema_version", "task", "outcome", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "outcome": {"enum": ["passed", "failed", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "finalists": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
      "then": {"required": ["finalists", "evidence"]}
    }
  ],
  "additionalProperties": false
}
