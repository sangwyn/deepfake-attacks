{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangwyn/deepfake-attacks/schemas/attack-status.schema.json",
  "title": "AADD attack task status",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "attack",
    "scope",
    "outcome",
    "decision",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "attack": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "scope": {"enum": ["smoke", "development", "full", "official"]},
    "outcome": {
      "enum": ["queued", "running", "passed", "failed", "blocked", "cancelled"]
    },
    "decision": {
      "enum": ["retain", "reject", "baseline", "pending", "not_applicable"]
    },
    "summary": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "job_spec": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "configs": {"$ref": "#/$defs/nonEmptyPaths"},
    "results": {"$ref": "#/$defs/nonEmptyPaths"},
    "evidence": {"$ref": "#/$defs/nonEmptyPaths"},
    "verifier_report": {"type": "string", "minLength": 1},
    "error": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "queued"}}, "required": ["outcome"]},
      "then": {"required": ["job_id", "job_spec"]}
    },
    {
      "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
      "then": {"required": ["configs", "results", "evidence", "verifier_report"]}
    }
  ],
  "$defs": {
    "nonEmptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
