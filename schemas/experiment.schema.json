{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangwyn/deepfake-attacks/schemas/experiment.schema.json",
  "title": "AADD scientific experiment",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "scope",
    "seed",
    "server_config",
    "dataset",
    "attack",
    "models",
    "constraint",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "scope": {"enum": ["smoke", "development", "full", "official"]},
    "seed": {"type": "integer", "minimum": 0},
    "server_config": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "required": ["manifest", "source_label", "selection"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "source_label": {"enum": [0, 1]},
        "selection": {"enum": ["manifest-order", "all"]},
        "sample_limit": {"type": ["integer", "null"], "minimum": 1},
        "require_clean_correct": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "attack": {
      "type": "object",
      "required": ["name", "module", "source_model", "target_class", "parameters"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "module": {"type": "string", "pattern": "^attacks\\.[A-Za-z0-9_.]+$"},
        "source_model": {"enum": ["vit_b_16", "densenet121_dct"]},
        "target_class": {"enum": [0, 1]},
        "parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["vit_b_16", "densenet121_dct"]}
    },
    "constraint": {
      "type": "object",
      "required": ["norm", "epsilon", "pixel_range"],
      "properties": {
        "norm": {"const": "linf"},
        "epsilon": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "pixel_range": {"const": [0.0, 1.0]},
        "output_format": {"const": "png"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["targeted_asr", "ssim", "lpips"],
      "properties": {
        "targeted_asr": {"const": true},
        "ssim": {"const": true},
        "lpips": {"const": true},
        "report_clean_accuracy": {"type": "boolean"},
        "report_transfer_matrix": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
