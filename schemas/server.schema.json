{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sangwyn/deepfake-attacks/schemas/server.schema.json",
  "title": "AADD server binding",
  "type": "object",
  "required": [
    "schema_version",
    "project_root",
    "dataset",
    "assets",
    "runtime",
    "environment",
    "opencode",
    "gpu_queue"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_root": {"const": "/home/aiattacks/oleg/aadd-attack-pipeline"},
    "dataset": {
      "type": "object",
      "required": ["celeb_a_root", "official_aadd_root", "read_only", "classes"],
      "properties": {
        "celeb_a_root": {"const": "/home/aiattacks/dataset/celebA"},
        "official_aadd_root": {"type": ["string", "null"]},
        "read_only": {"const": true},
        "classes": {
          "type": "object",
          "required": ["TRAIN_REAL", "TRAIN_FAKE", "TEST_REAL", "TEST_FAKE"],
          "additionalProperties": {
            "type": "object",
            "required": ["path", "label", "expected_count"],
            "properties": {
              "path": {"type": "string"},
              "label": {"enum": [0, 1]},
              "expected_count": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["weights_root", "models", "lpips"],
      "properties": {
        "weights_root": {"type": "string"},
        "models": {"type": "object"},
        "lpips": {"type": "object"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["runs_root", "tracking_root"],
      "properties": {
        "runs_root": {"type": "string"},
        "tracking_root": {"const": "tracking"}
      },
      "additionalProperties": false
    },
    "environment": {"type": "object"},
    "opencode": {"type": "object"},
    "gpu_queue": {"type": "object"}
  },
  "additionalProperties": false
}
