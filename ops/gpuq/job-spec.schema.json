{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sangwyn.github.io/deepfake-attacks/gpuq/job-spec.schema.json",
  "title": "GPUQ attack experiment job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_kind",
    "config_path",
    "run_dir",
    "requested_memory_mb",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_kind": {
      "const": "attack-experiment"
    },
    "config_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "run_dir": {
      "type": "string",
      "pattern": "^tracking/runs/[^/]+/[^/]+(?:/.+)?$"
    },
    "requested_memory_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 604800
    },
    "priority": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100,
      "default": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 1
    }
  }
}
